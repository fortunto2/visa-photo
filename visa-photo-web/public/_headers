# Link headers (RFC 8288): how an agent finds the machine-readable side of the site without
# parsing HTML first. Same set and rels as rustman.org, for what exists here.
/*
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </llms-full.txt>; rel="alternate"; type="text/plain"; title="Full text of every document"
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </specs.json>; rel="service-desc"; type="application/json"; title="Photo specifications"
  Link: </.well-known/agent-skills/index.json>; rel="service-desc"; type="application/json"; title="Agent skills"
  Link: </.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json"; title="MCP server"
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </.well-known/ard.json>; rel="ard"; type="application/json"; title="Agentic resource catalogue"
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Cloudflare Pages types extensionless files as octet-stream, which hides what these are
# from the agents they exist for.
/.well-known/*
  Access-Control-Allow-Origin: *

/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8

/specs.json
  Content-Type: application/json; charset=utf-8

# The models are immutable and large; let them sit in the browser cache.
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# The markdown twins are the same facts as the HTML page at the same address, for agents that
# would rather not parse a tool out of a document. They must not compete with the page they
# mirror, so they are served but never indexed.
/*.md
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
