---
import type { ActiveLang } from "../data/locales";
import { idOf, type CatalogEntry } from "../data/catalog";
import type { Dict } from "../data/i18n";
import { CONSULT_COPY, TOPICS, consultOffer } from "../data/consult";
import { path } from "../lib/site";

/**
 * The request form for visa help (see src/data/consult.ts for what it is and is not).
 *
 * A <details>, so opening needs no script. Where a consultant answers (the US pages) the closed
 * state is an open banner with the offer in full and a tag, styled apart from the checker; on
 * other visa pages it is one folded line naming the country, so the page stays a photo page.
 * The country is the page's, and the topics are the ones that fit it: a request from the Canada
 * page is about Canada. Sending posts JSON to /api/lead, which the `visayes-leads` Worker answers
 * on the same origin.
 */
interface Props { lang: ActiveLang; entry: CatalogEntry; t: Dict }
const { lang, entry, t } = Astro.props as Props;

const offer = consultOffer(entry);
const partner = offer === "us-visa" || offer === "us-dv";
const c = CONSULT_COPY[lang];
const pitch = offer === "us-dv" ? c.usDv : c.usVisa;
const countryName = t.country[idOf(entry)] ?? entry.country;
---

{offer && (
  <details id="consult" class:list={["consult", { "consult-partner": partner }]} data-testid="consult" data-offer={offer}>
    <summary>
      {partner ? (
        <>
          <span class="consult-tag">
            <svg width="20" height="14" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${entry.flag}`} /></svg>
            {c.tag}
          </span>
          <span class="consult-text">
            <strong>{pitch.heading}</strong>
            <span class="consult-pitch">{pitch.body}</span>
          </span>
          <span class="consult-cta">{c.open}</span>
        </>
      ) : (
        <>
          <span class="consult-icon"><svg width="24" height="24" aria-hidden="true"><use href="#ic-question" /></svg></span>
          <span class="consult-text">
            <strong>{c.heading(countryName)}</strong>
            <span>{c.open}</span>
          </span>
          <svg class="consult-chevron" width="18" height="18" aria-hidden="true"><use href="#ic-arrow" /></svg>
        </>
      )}
    </summary>

    <form
      class="consult-form"
      novalidate
      data-lang={lang}
      data-country={entry.country}
      data-doc={entry.doc}
      data-sending={c.sending}
      data-sent={c.sent}
      data-failed={c.failed}
    >
      {!partner && <p class="consult-body">{c.body}</p>}

      <label>
        <span>{c.topic}</span>
        <select name="topic" required>
          <option value="" disabled selected>{c.choose}</option>
          {offer && TOPICS[offer].map((k) => <option value={k}>{c.topics[k]}</option>)}
        </select>
      </label>
      <label class="consult-half">
        <span>{c.name}</span>
        <input name="name" required maxlength="100" autocomplete="name" />
      </label>
      <label class="consult-half">
        <span>{c.contact}</span>
        <input name="contact" required minlength="3" maxlength="200" autocomplete="email" />
      </label>
      <input type="hidden" name="destination" value={entry.country} />
      <label>
        <span>{c.message}</span>
        <textarea name="message" rows="3" maxlength="2000" placeholder={offer === "us-dv" ? c.usDv.hint : c.messageHint}></textarea>
      </label>

      {/* Never shown to people; a bot that fills every field fills this one too. */}
      <label class="consult-trap" aria-hidden="true">
        Website <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <label class="consult-consent">
        <input type="checkbox" name="consent" required />
        <span>{c.consent}{" "}<a href={path(lang, "privacy")} target="_blank" rel="noopener">{c.privacy}</a></span>
      </label>

      <button class="consult-submit" type="submit">{c.submit}</button>
      <p class="consult-status" role="status" aria-live="polite"></p>
    </form>
  </details>
)}

<script>
  import { track } from "../lib/analytics";

  /*
   * The funnel: consult_teaser_clicked (the card at the top, counted by markup) → consult_opened →
   * consult_started (the first field touched) → consult_requested. A send that does not happen is its own event with a reason, because silence
   * after opening looks the same whether the person changed their mind, could not tick the box, or
   * the request failed.
   */
  for (const details of document.querySelectorAll<HTMLDetailsElement>("details.consult")) {
    const form = details.querySelector<HTMLFormElement>(".consult-form")!;
    const status = form.querySelector<HTMLElement>(".consult-status")!;
    const button = form.querySelector<HTMLButtonElement>(".consult-submit")!;
    const d = form.dataset;
    const placement = `${d.country}:${d.doc}`;

    // On `toggle`, not a click on <summary>: a click also closes it, and the teaser opens it by script.
    details.addEventListener("toggle", () => {
      if (details.open) track("consult_opened", { placement });
    });
    // Tells "read it and left" from "began and gave up", which look the same without it.
    form.addEventListener("input", () => track("consult_started", { placement }), { once: true });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      // The browser's own messages, in the visitor's language, for empty or unticked fields.
      if (!form.reportValidity()) {
        const field = form.querySelector<HTMLInputElement>(":invalid")?.name ?? "unknown";
        track("consult_invalid", { placement, field });
        return;
      }

      const data = new FormData(form);
      const body = {
        name: String(data.get("name") ?? ""),
        contact: String(data.get("contact") ?? ""),
        destination: String(data.get("destination") ?? ""),
        topic: String(data.get("topic") ?? ""),
        message: String(data.get("message") ?? ""),
        website: String(data.get("website") ?? ""),
        consent: data.get("consent") === "on",
        lang: d.lang,
        page: location.pathname,
      };

      button.disabled = true;
      status.dataset.state = "";
      status.textContent = d.sending ?? "";
      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.dataset.state = "sent";
        status.textContent = d.sent ?? "";
        form.querySelectorAll("label, .consult-submit").forEach((el) => el.remove());
        track("consult_requested", {
          placement,
          country: d.country ?? "",
          doc: d.doc ?? "",
          destination: body.destination,
          topic: body.topic,
        });
      } catch (e) {
        // An HTTP status (403 origin, 429 rate, 400 field, 500 store) or "network".
        track("consult_failed", { placement, reason: /^\d{3}$/.test(String((e as Error).message)) ? (e as Error).message : "network" });
        status.dataset.state = "failed";
        status.textContent = d.failed ?? "";
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .consult {
    margin: 16px 0 0;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg, 18px);
    box-shadow: var(--sh-sm);
  }
  .consult summary {
    display: flex; align-items: center; gap: 14px; padding: 16px 20px;
    cursor: pointer; list-style: none;
  }
  .consult summary::-webkit-details-marker { display: none; }
  .consult-icon {
    display: grid; place-items: center; flex-shrink: 0; width: 42px; height: 42px;
    border-radius: 12px; background: var(--amber-soft); color: var(--amber);
  }
  .consult-text { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .consult-text strong { font-size: 17px; }
  .consult-text span { color: var(--teal); font-weight: 700; font-size: 15px; }
  .consult-chevron { flex-shrink: 0; color: var(--ink-faint); transform: rotate(90deg); transition: transform .15s; }
  .consult[open] .consult-chevron { transform: rotate(-90deg); }

  /* The partner's banner: inverted and tagged so it reads as someone else's offer beside the
     checker, not a step of it (the partner links below are teal-tinted, so a tint would merge).
     Ink and surface swap in dark mode, which keeps it inverted there too. */
  .consult-partner { overflow: hidden; }
  .consult-partner summary {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px 20px; padding: 18px 20px;
    background: var(--ink); color: var(--surface);
  }
  .consult-tag {
    grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; gap: 7px;
    padding: 3px 10px 3px 7px; border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--surface) 30%, var(--ink));
    color: color-mix(in srgb, var(--surface) 75%, var(--ink));
    font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  }
  .consult-tag svg { border-radius: 2px; }
  .consult-partner .consult-text strong { font-size: 18px; }
  .consult-partner .consult-pitch {
    color: color-mix(in srgb, var(--surface) 78%, var(--ink)); font-weight: 400; font-size: 15px; line-height: 1.5;
  }
  .consult-cta {
    padding: 12px 22px; border-radius: var(--r-pill); white-space: nowrap;
    background: var(--surface); color: var(--ink); font-weight: 700;
  }
  .consult-partner[open] .consult-cta { display: none; }
  .consult-partner .consult-form { padding-top: 18px; }
  @media (max-width: 639px) {
    .consult-partner summary { grid-template-columns: 1fr; }
    .consult-cta { justify-self: start; }
  }

  .consult-form { display: grid; gap: 12px; padding: 0 20px 20px; }
  .consult-form > * { grid-column: 1 / -1; }
  @media (min-width: 640px) {
    .consult-form { grid-template-columns: 1fr 1fr; }
    .consult-form > .consult-half { grid-column: auto; }
  }
  .consult-body { margin: 0; color: var(--ink-soft); font-size: 15px; line-height: 1.5; }
  .consult-form label { display: grid; gap: 5px; font-size: 14px; color: var(--ink-soft); }
  .consult-form input:not([type="checkbox"]), .consult-form select, .consult-form textarea {
    width: 100%; box-sizing: border-box; padding: 11px 12px;
    font: inherit; font-size: 16px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-sm);
  }
  .consult-form textarea { resize: vertical; }
  .consult-form :is(input, select, textarea):focus { border-color: var(--teal); outline: none; }
  .consult-form .consult-consent { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; line-height: 1.45; }
  .consult-consent input { margin: 2px 0 0; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--teal); }
  /* Clipped in place, not pushed off-screen: in an RTL page an element at left:-9999px is
     scrollable, and the Arabic pages grew a sideways scroll. */
  .consult-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .consult-submit {
    justify-self: start; padding: 12px 22px; border: 0; border-radius: var(--r-pill);
    background: var(--teal); color: var(--on-teal); font: inherit; font-weight: 700; cursor: pointer;
  }
  .consult-submit:disabled { opacity: .6; cursor: progress; }
  .consult-status { margin: 0; font-size: 15px; color: var(--ink-soft); }
  .consult-status:empty { display: none; }
  .consult-status[data-state="sent"] { color: var(--ok); font-weight: 700; }
  .consult-status[data-state="failed"] { color: var(--amber); }
</style>
