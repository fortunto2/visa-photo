---
/**
 * Someone else's offer beside the headline: a card in the empty column on a wide screen, one line
 * under the headline on a narrow one. The tool keeps its full width and stays where it was, since
 * the photo is still what the page is for. Inverted and tagged, so it reads as an offer next to
 * the checker rather than a step of it.
 *
 * DocPage opens the column for it (.doc-hero.has-offer in site.css) and decides which offer goes
 * there: the consultant on US pages, the travel partner on other visa pages.
 */
interface Props {
  href: string;
  /** A paid link that leaves the site: new tab, rel="sponsored". */
  sponsored?: boolean;
  tag: string;
  /** Flag of the country the offer is about; otherwise `icon`, an id from the sprite. */
  flag?: string;
  icon?: string;
  heading: string;
  short: string;
  cta: string;
  /** Counted by the analytics snippet on click. */
  event: string;
  placement: string;
  testid: string;
  /** Russian ad-law line, which has to sit next to the link on every screen size. */
  adLabel?: string;
}
const { href, sponsored, tag, flag, icon, heading, short, cta, event, placement, testid, adLabel } =
  Astro.props as Props;
---

<a
  class="teaser"
  href={href}
  data-testid={testid}
  data-sda-event={event}
  data-sda-placement={placement}
  {...(sponsored ? { target: "_blank", rel: "sponsored noopener" } : {})}
>
  <span class="teaser-tag">
    {flag
      ? <svg width="20" height="14" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${flag}`} /></svg>
      : icon && <svg width="14" height="14" aria-hidden="true"><use href={`#${icon}`} /></svg>}
    {tag}
  </span>
  <strong>{heading}</strong>
  <span class="teaser-short">{short}</span>
  <span class="teaser-cta">{cta}</span>
  {adLabel && <small class="teaser-ad">{adLabel}</small>}
  <svg class="teaser-arrow" width="18" height="18" aria-hidden="true"><use href="#ic-arrow" /></svg>
</a>

<style>
  .teaser {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 6px 12px;
    margin: 0 0 16px; padding: 12px 14px; border-radius: var(--r-md);
    background: var(--ink); color: var(--surface); text-decoration: none;
  }
  .teaser-tag {
    grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; gap: 7px;
    padding: 2px 9px 2px 6px; border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--surface) 30%, var(--ink));
    color: color-mix(in srgb, var(--surface) 75%, var(--ink));
    font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  }
  .teaser-tag svg { border-radius: 2px; }
  .teaser strong { font-size: 16px; line-height: 1.3; }
  .teaser-short, .teaser-cta { display: none; }
  .teaser-arrow { flex-shrink: 0; }
  :global([dir="rtl"]) .teaser-arrow { transform: scaleX(-1); }
  /* After the arrow, on a row of its own. */
  .teaser-ad { grid-column: 1 / -1; order: 1; color: color-mix(in srgb, var(--surface) 60%, var(--ink)); font-size: 11.5px; }

  @media (min-width: 1024px) {
    .teaser { grid-template-columns: 1fr; gap: 10px; padding: 20px; margin: 0; border-radius: var(--r-lg); }
    .teaser strong { font-size: 19px; }
    .teaser-short {
      display: block; color: color-mix(in srgb, var(--surface) 78%, var(--ink)); font-size: 15px; line-height: 1.5;
    }
    .teaser-cta {
      display: block; justify-self: start; margin-top: 4px; padding: 11px 20px; border-radius: var(--r-pill);
      background: var(--surface); color: var(--ink); font-weight: 700;
    }
    .teaser-arrow { display: none; }
  }
</style>
