---
import type { ActiveLang } from "../data/locales";
import type { CatalogEntry } from "../data/catalog";
import { CONSULT_COPY, consultOffer } from "../data/consult";

/**
 * The consultant offer at the top of a US page, pointing at the banner with the form (#consult).
 *
 * On a wide screen it is a card in the empty column beside the headline; on a narrow one it shrinks
 * to one line under the headline. Either way the tool keeps its full width and stays where it was:
 * the photo is still what the page is for. The link works without script; with it, the banner
 * also opens on arrival.
 */
interface Props { lang: ActiveLang; entry: CatalogEntry }
const { lang, entry } = Astro.props as Props;

const offer = consultOffer(entry);
const c = CONSULT_COPY[lang];
const pitch = offer === "us-dv" ? c.usDv : c.usVisa;
---

{(offer === "us-visa" || offer === "us-dv") && (
  <a
    class="teaser"
    href="#consult"
    data-testid="consult-teaser"
    data-sda-event="consult_teaser_clicked"
    data-sda-placement={`${entry.country}:${entry.doc}`}
  >
    <span class="teaser-tag">
      <svg width="20" height="14" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${entry.flag}`} /></svg>
      {c.tag}
    </span>
    <strong>{pitch.heading}</strong>
    <span class="teaser-short">{pitch.short}</span>
    <span class="teaser-cta">{c.open}</span>
    <svg class="teaser-arrow" width="18" height="18" aria-hidden="true"><use href="#ic-arrow" /></svg>
  </a>
)}

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".teaser")) {
    link.addEventListener("click", () => {
      const banner = document.getElementById("consult");
      if (banner instanceof HTMLDetailsElement) banner.open = true;
    });
  }
</script>

<style>
  /* Inverted like the banner it points at, so both read as the partner's, not the checker's. */
  .teaser {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 6px 12px;
    margin: 0 0 16px; padding: 12px 14px; border-radius: var(--r-md);
    background: var(--ink); color: var(--surface); text-decoration: none;
  }
  .teaser-tag {
    grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; gap: 7px;
    padding: 2px 9px 2px 6px; border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--surface) 30%, var(--ink));
    color: color-mix(in srgb, var(--surface) 75%, var(--ink));
    font-size: 11.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  }
  .teaser-tag svg { border-radius: 2px; }
  .teaser strong { font-size: 16px; line-height: 1.3; }
  .teaser-short, .teaser-cta { display: none; }
  .teaser-arrow { flex-shrink: 0; }
  :global([dir="rtl"]) .teaser-arrow { transform: scaleX(-1); }

  /* Beside the headline: the column DocPage opens for it (see .doc-hero.has-offer). */
  @media (min-width: 1024px) {
    .teaser { grid-template-columns: 1fr; gap: 10px; padding: 20px; margin: 0; border-radius: var(--r-lg); }
    .teaser strong { font-size: 19px; }
    .teaser-short {
      display: block; color: color-mix(in srgb, var(--surface) 78%, var(--ink)); font-size: 15px; line-height: 1.5;
    }
    .teaser-cta {
      display: block; justify-self: start; margin-top: 4px; padding: 11px 20px; border-radius: var(--r-pill);
      background: var(--surface); color: var(--ink); font-weight: 700;
    }
    .teaser-arrow { display: none; }
  }
</style>
