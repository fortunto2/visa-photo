---
import type { ActiveLang } from "../data/locales";
import { idOf, type CatalogEntry } from "../data/catalog";
import type { Dict } from "../data/i18n";
import { CONSULT_COPY, consultOffer } from "../data/consult";
import { path } from "../lib/site";

/**
 * The visa-help chat (see src/data/consult.ts for what it is and is not).
 *
 * A <details>, so the page stays a photo page until someone opens it. Where a consultant answers
 * (the US pages) the closed state is an open banner with the offer in full and a tag, styled apart
 * from the checker; on other visa pages it is one folded line naming the country. The first
 * message is written here, not by the model: it costs nothing and says an AI is answering. Each
 * message after that goes to /api/chat, which keeps the history; the browser only remembers the
 * chat id until the page is left.
 */
interface Props { lang: ActiveLang; entry: CatalogEntry; t: Dict }
const { lang, entry, t } = Astro.props as Props;

const offer = consultOffer(entry);
const partner = offer === "us-visa" || offer === "us-dv";
const c = CONSULT_COPY[lang];
const pitch = offer === "us-dv" ? c.usDv : c.usVisa;
const countryName = t.country[idOf(entry)] ?? entry.country;
const greeting = offer === "general" ? c.greet.general(countryName) : offer ? c.greet[offer] : "";
---

{offer && (
  <details id="consult" class:list={["consult", { "consult-partner": partner }]} data-testid="consult" data-offer={offer}>
    <summary>
      {partner ? (
        <>
          <span class="consult-tag">
            <svg width="20" height="14" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${entry.flag}`} /></svg>
            {c.tag}
          </span>
          <span class="consult-text">
            <strong>{pitch.heading}</strong>
            <span class="consult-pitch">{pitch.body}</span>
          </span>
          <span class="consult-cta">{c.open}</span>
        </>
      ) : (
        <>
          <span class="consult-icon"><svg width="24" height="24" aria-hidden="true"><use href="#ic-question" /></svg></span>
          <span class="consult-text">
            <strong>{c.heading(countryName)}</strong>
            <span>{c.open}</span>
          </span>
          <svg class="consult-chevron" width="18" height="18" aria-hidden="true"><use href="#ic-arrow" /></svg>
        </>
      )}
    </summary>

    <div
      class="chat"
      data-lang={lang}
      data-country={entry.country}
      data-doc={entry.doc}
      data-failed={c.failed}
      data-closed={c.closed}
    >
      {!partner && <p class="consult-body">{c.body}</p>}
      <ol class="chat-log" aria-live="polite">
        <li class="bot">{greeting}</li>
      </ol>
      <form class="chat-input">
        <textarea name="message" rows="2" maxlength="600" required placeholder={c.placeholder} aria-label={c.placeholder}></textarea>
        <button type="submit">{c.send}</button>
      </form>
      <p class="chat-notice">{c.notice}{" "}<a href={path(lang, "privacy")} target="_blank" rel="noopener">{c.privacy}</a></p>
      <noscript><p class="chat-notice">{c.failed}</p></noscript>
    </div>
  </details>
)}

<script>
  import { track } from "../lib/analytics";

  /*
   * The funnel: consult_teaser_clicked (the card at the top, counted by markup) → consult_opened →
   * consult_started (the first message sent) → consult_requested (a contact turned it into a
   * request). A failed send is its own event with a reason, because silence after a message looks
   * the same whether the person left or the request failed.
   */
  for (const details of document.querySelectorAll<HTMLDetailsElement>("details.consult")) {
    const chat = details.querySelector<HTMLElement>(".chat")!;
    const log = chat.querySelector<HTMLOListElement>(".chat-log")!;
    const form = chat.querySelector<HTMLFormElement>(".chat-input")!;
    const input = form.querySelector<HTMLTextAreaElement>("textarea")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const d = chat.dataset;
    const placement = `${d.country}:${d.doc}`;
    let chatId: string | null = null;
    let sent = 0;

    // On `toggle`, not a click on <summary>: a click also closes it, and the teaser opens it by script.
    details.addEventListener("toggle", () => {
      if (!details.open) return;
      track("consult_opened", { placement });
      input.focus({ preventScroll: true });
    });

    const say = (who: "me" | "bot", text: string) => {
      const li = document.createElement("li");
      li.className = who;
      li.textContent = text;
      log.append(li);
      log.scrollTop = log.scrollHeight;
      return li;
    };

    // Enter sends, Shift+Enter breaks the line; an IME composition is never cut short.
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey && !event.isComposing) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      if (!message || button.disabled) return;
      say("me", message);
      input.value = "";
      button.disabled = true;
      const answer = say("bot", "…");
      answer.classList.add("wait");
      if (++sent === 1) track("consult_started", { placement });

      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ chatId, message, lang: d.lang, page: location.pathname, country: d.country, doc: d.doc }),
        });
        if (!res.ok) throw new Error(String(res.status));
        const r = (await res.json()) as { chatId: string; reply: string | null; closed: boolean; lead: boolean };
        chatId = r.chatId;
        answer.classList.remove("wait");
        answer.textContent = r.reply ?? (r.closed ? d.closed ?? "" : d.failed ?? "");
        if (r.lead) track("consult_requested", { placement, country: d.country ?? "", doc: d.doc ?? "", source: "chat" });
        if (r.closed) {
          if (r.reply) say("bot", d.closed ?? "");
          input.disabled = true;
          return;
        }
      } catch (e) {
        // An HTTP status (403 origin, 429 rate, 400 message, 502 model, 503 budget) or "network".
        const reason = String((e as Error).message);
        track("consult_failed", { placement, reason: /^\d{3}$/.test(reason) ? reason : "network" });
        answer.classList.remove("wait");
        answer.textContent = d.failed ?? "";
      }
      button.disabled = false;
      input.focus();
    });
  }
</script>

<style>
  .consult {
    margin: 16px 0 0;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg, 18px);
    box-shadow: var(--sh-sm);
  }
  .consult summary {
    display: flex; align-items: center; gap: 14px; padding: 16px 20px;
    cursor: pointer; list-style: none;
  }
  .consult summary::-webkit-details-marker { display: none; }
  .consult-icon {
    display: grid; place-items: center; flex-shrink: 0; width: 42px; height: 42px;
    border-radius: 12px; background: var(--amber-soft); color: var(--amber);
  }
  .consult-text { display: flex; flex-direction: column; gap: 2px; flex: 1; }
  .consult-text strong { font-size: 17px; }
  .consult-text span { color: var(--teal); font-weight: 700; font-size: 15px; }
  .consult-chevron { flex-shrink: 0; color: var(--ink-faint); transform: rotate(90deg); transition: transform .15s; }
  .consult[open] .consult-chevron { transform: rotate(-90deg); }

  /* The consultant's banner: inverted and tagged so it reads as an offer beside the checker, not a
     step of it (the partner links below are teal-tinted, so a tint would merge). Ink and surface
     swap in dark mode, which keeps it inverted there too. */
  .consult-partner { overflow: hidden; }
  .consult-partner summary {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px 20px; padding: 18px 20px;
    background: var(--ink); color: var(--surface);
  }
  .consult-tag {
    grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; gap: 7px;
    padding: 3px 10px 3px 7px; border-radius: var(--r-pill);
    border: 1px solid color-mix(in srgb, var(--surface) 30%, var(--ink));
    color: color-mix(in srgb, var(--surface) 75%, var(--ink));
    font-size: 12px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
  }
  .consult-tag svg { border-radius: 2px; }
  .consult-partner .consult-text strong { font-size: 18px; }
  .consult-partner .consult-pitch {
    color: color-mix(in srgb, var(--surface) 78%, var(--ink)); font-weight: 400; font-size: 15px; line-height: 1.5;
  }
  .consult-cta {
    padding: 12px 22px; border-radius: var(--r-pill); white-space: nowrap;
    background: var(--surface); color: var(--ink); font-weight: 700;
  }
  .consult-partner[open] .consult-cta { display: none; }
  .consult-partner .chat { padding-top: 18px; }
  @media (max-width: 639px) {
    .consult-partner summary { grid-template-columns: 1fr; }
    .consult-cta { justify-self: start; }
  }

  .chat { display: grid; gap: 12px; padding: 0 20px 20px; }
  .consult-body { margin: 0; color: var(--ink-soft); font-size: 15px; line-height: 1.5; }
  .chat-log {
    display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none;
    max-height: 360px; overflow-y: auto; overscroll-behavior: contain;
  }
  /* :global because the script adds these after render, and they carry no scope attribute. */
  .chat-log :global(li) {
    max-width: 85%; padding: 10px 14px; border-radius: 16px;
    font-size: 15px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .chat-log :global(.bot) { align-self: flex-start; background: var(--bg); border: 1px solid var(--line); border-end-start-radius: 4px; }
  .chat-log :global(.me) { align-self: flex-end; background: var(--teal-soft); border-end-end-radius: 4px; }
  .chat-log :global(.wait) { color: var(--ink-faint); }
  .chat-input { display: flex; gap: 8px; align-items: flex-end; }
  .chat-input textarea {
    flex: 1; min-width: 0; box-sizing: border-box; padding: 11px 12px; resize: none;
    font: inherit; font-size: 16px; color: var(--ink);
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--r-sm);
  }
  .chat-input textarea:focus { border-color: var(--teal); outline: none; }
  .chat-input button {
    padding: 12px 20px; border: 0; border-radius: var(--r-pill);
    background: var(--teal); color: var(--on-teal); font: inherit; font-weight: 700; cursor: pointer;
  }
  .chat-input button:disabled, .chat-input textarea:disabled { opacity: .6; cursor: progress; }
  .chat-notice { margin: 0; color: var(--ink-soft); font-size: 13px; line-height: 1.45; }
</style>
