---
import Page from "../../layouts/Page.astro";
import PdfTool from "../../components/PdfTool.tsx";
import { langsFor, dict, type ActiveLang } from "../../data/locales";
import { absolute, path } from "../../lib/site";

/**
 * The same question as the photo compressor, asked about a document.
 *
 * It earns its own page because the unit is different (megabytes, not kilobytes), the file is
 * different, and the reason to care about doing it locally is much stronger: the PDFs people
 * shrink for an upload are passports, bank statements and contracts, and every other tool for
 * this asks them to hand exactly those to a server.
 */
export function getStaticPaths() {
  return langsFor(["compress-pdf"]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: ActiveLang };
const t = dict(lang);
const k = t.pdfPage!;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: k.h1,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any browser",
    description: k.lead,
    url: absolute(path(lang, "compress-pdf")),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
---

<Page lang={lang} t={t} title={k.title} description={k.lead} segments={["compress-pdf"]} schema={schema}>
  <p class="crumb"><a href={path(lang)}>{t.nav.countries}</a></p>

  <h1>{k.h1}</h1>
  <p class="answer">{k.lead}</p>

  <PdfTool
    client:load
    page={{
      target: k.target, run: k.run, working: k.working, was: k.was, now: k.now,
      pages: k.pages, missed: k.missed, rasterWarning: k.rasterWarning,
      keptText: k.keptText, becameImages: k.becameImages,
      download: k.download, fileLabel: k.fileLabel,
    }}
    strings={{
      ...t.tool,
      dropSub: t.tool.dropSub(k.h1),
      framedTo: t.tool.framedTo(""),
      downloadSheet: t.tool.downloadSheet(0),
      guideEyes: t.tool.guideEyes(""),
      removeBgHint: t.tool.removeBgHint,
      modelDefault: t.tool.modelDefault,
      noEditingAtAction: t.warn.noEditingAtAction,
      proceedAnyway: t.warn.proceedAnyway,
      mbUnit: t.unit.mb,
      modelsPageLink: t.tool.modelsPageLink,
      maxKb: t.tool.maxKb,
      maxKbHint: t.tool.maxKbHint,
      fileLabel: t.spec.file,
    }}
  />

  <ul class="trust">
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.free}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-shield" /></svg>{t.trust.inBrowser}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noServer}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noSignup}</li>
  </ul>
  <p class="trust-why">{t.trust.why}</p>

  <div class="seo" style="margin-top:44px">
    <section>
      <h2>
        <span class="ico"><svg width="22" height="22" aria-hidden="true"><use href="#ic-question" /></svg></span>
        {k.whenToUse}
      </h2>
      <p>{k.whenToUseBody}</p>
    </section>
    <section><p class="disclaimer">{t.seo.disclaimerShort}</p></section>
  </div>
</Page>
