---
import Page from "../../layouts/Page.astro";
import { langsFor, dict, type ActiveLang } from "../../data/locales";
import { SITE, absolute, path } from "../../lib/site";

/**
 * What the site collects, in the order a reader would ask.
 *
 * The photograph first, because that is the only thing anyone here actually worries about, and
 * the answer is that it never moves. Everything after it is the small print of a static site:
 * a model download, a counter that sets no cookie, a Google container that starts switched off.
 *
 * Every claim was checked against the code, including reading the analytics script to confirm
 * it creates no identifier. This is the one page a sceptical reader will test, so overstating
 * on it would cost more than saying nothing.
 */
export function getStaticPaths() {
  return langsFor(["privacy"]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: ActiveLang };
const t = dict(lang);
const p = t.privacyPage!;

const sections = [
  { h: p.photoH, b: p.photoP },
  { h: p.modelsH, b: p.modelsP },
  { h: p.countingH, b: p.countingP },
  { h: p.googleH, b: p.googleP },
  { h: p.storedH, b: p.storedP },
  { h: p.hostingH, b: p.hostingP },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: p.h1,
    description: p.lead,
    url: absolute(path(lang, "privacy")),
  },
];
---

<Page lang={lang} t={t} title={p.title} description={p.lead} segments={["privacy"]} schema={schema}>
  <p class="crumb"><a href={path(lang)}>{t.nav.countries}</a></p>

  <h1>{p.h1}</h1>
  <p class="answer">{p.lead}</p>

  <div class="seo prose">
    {sections.map((s) => (
      <section>
        <h2>{s.h}</h2>
        <p>{s.b}</p>
      </section>
    ))}

    <section>
      <h2>{p.rightsH}</h2>
      <p>{p.rightsP}</p>
      {/* The answer is only useful if it can be taken back, and asking someone to clear their
          browser storage by hand is not an answer. */}
      <p>
        <button class="tool-btn" type="button" id="consent-reset" data-testid="consent-reset">
          {p.changeAnswer}
        </button>
        <span class="hint" id="consent-cleared" hidden>{p.answerCleared}</span>
      </p>
    </section>

    <section>
      <h2>{p.contactH}</h2>
      <p>{p.contactP}</p>
      <p><a href={SITE.repo} rel="noopener">{SITE.repo}</a></p>
    </section>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById("consent-reset");
      if (!btn) return;
      btn.addEventListener("click", function () {
        try { localStorage.removeItem("visayes-consent"); } catch (e) { /* nothing to clear */ }
        // Deny immediately rather than waiting for the next page: the visitor asked for it now.
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(["consent", "update", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        }]);
        document.getElementById("consent-cleared").hidden = false;
        btn.disabled = true;
      });
    })();
  </script>
</Page>
