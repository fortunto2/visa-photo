---
import Page from "../../layouts/Page.astro";
import CompressTool from "../../components/CompressTool.tsx";
import { langsFor, dict, type ActiveLang } from "../../data/locales";
import { absolute, path } from "../../lib/site";

/**
 * Weight, on its own.
 *
 * The catalogue answers "what size", but portals refuse far more uploads over a number of
 * kilobytes than over millimetres — and they say which limit was broken almost never. This is
 * the page for the number, and it exists separately because the search for it is separate:
 * always phrased with a specific figure, because a form stated one.
 */
export function getStaticPaths() {
  return langsFor(["compress"]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: ActiveLang };
const t = dict(lang);
const k = t.kbPage!;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: k.h1,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any browser",
    description: k.lead,
    url: absolute(path(lang, "compress")),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
];
---

<Page lang={lang} t={t} title={k.title} description={k.lead} segments={["compress"]} schema={schema}>
  <p class="crumb"><a href={path(lang)}>{t.nav.countries}</a></p>

  <h1>{k.h1}</h1>
  <p class="answer">{k.lead}</p>

  <CompressTool
    client:load
    page={{
      target: k.target,
      run: k.run,
      working: k.working,
      was: k.was,
      now: k.now,
      missed: k.missed,
      keepSize: k.keepSize,
      download: k.download,
    }}
    strings={{
      ...t.tool,
      dropSub: t.tool.dropSub(k.h1),
      framedTo: t.tool.framedTo(""),
      downloadSheet: t.tool.downloadSheet(0),
      guideEyes: t.tool.guideEyes(""),
      removeBgHint: t.tool.removeBgHint,
      modelDefault: t.tool.modelDefault,
      noEditingAtAction: t.warn.noEditingAtAction,
      proceedAnyway: t.warn.proceedAnyway,
      mbUnit: t.unit.mb,
      maxKb: t.tool.maxKb,
      maxKbHint: t.tool.maxKbHint,
      fileLabel: t.spec.file,
      modelsPageLink: t.tool.modelsPageLink,
    }}
  />

  {/* Cropping and a weight limit together already exist one page over; a second editor here
      would be the same tool twice. */}
  <p class="hint" style="margin-top:16px">
    {k.alsoCropQ} <a href={path(lang, "custom")}>{k.alsoCropA}</a>
  </p>

  <ul class="trust">
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.free}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-shield" /></svg>{t.trust.inBrowser}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noServer}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noSignup}</li>
  </ul>
  <p class="trust-why">{t.trust.why}</p>

  <div class="seo" style="margin-top:44px">
    <section>
      <h2>
        <span class="ico"><svg width="22" height="22" aria-hidden="true"><use href="#ic-question" /></svg></span>
        {k.whenToUse}
      </h2>
      <p>{k.whenToUseBody}</p>
    </section>
    <section><p class="disclaimer">{t.seo.disclaimerShort}</p></section>
  </div>
</Page>
