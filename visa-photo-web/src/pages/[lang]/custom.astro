---
import Page from "../../layouts/Page.astro";
import CustomTool from "../../components/CustomTool.tsx";
import { PRESETS } from "../../lib/presets";
import { CATALOG, idOf } from "../../data/catalog";
import { langsFor, dict, type ActiveLang } from "../../data/locales";
import { absolute, path } from "../../lib/site";

export function getStaticPaths() {
  // Only where this page has been translated; see Dict for why there is no fallback.
  return langsFor(["custom"]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: ActiveLang };
const t = dict(lang);
// getStaticPaths only produced this route for locales that carry the block, so it is here.
const c = t.customPage!;

/** Everything the editor needs beyond width and height; dimensions come from the form. */
const base = PRESETS.custom;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: c.h1,
    description: c.lead,
    url: absolute(path(lang, "custom")),
  },
];
---

<Page lang={lang} t={t} title={c.title} description={c.lead} segments={["custom"]} schema={schema}>
  <p class="crumb"><a href={path(lang)}>{t.nav.countries}</a></p>

  <h1>{c.h1}</h1>
  <p class="answer">{c.lead}</p>

  <CustomTool
    client:load
    base={base}
    modelsHref={path(lang, "models")}
    ctx={{ preset: "custom", country: "custom", doc: "custom" }}
    custom={{
      width: c.width,
      height: c.height,
      unitMm: c.unitMm,
      unitPx: c.unitPx,
      dpi: c.dpi,
      presetHint: c.presetHint,
      unitLabel: c.unitLabel,
      fileSize: c.fileSize,
      units: { mm: t.unit.mm, cm: t.unit.cm, in: t.unit.in, px: t.unit.px },
      common: c.common,
    }}
    strings={{
      ...t.tool,
      dropSub: t.tool.dropSub(c.h1),
      framedTo: t.tool.framedTo(c.presetHint),
      downloadSheet: t.tool.downloadSheet(base.photo_count),
      guideEyes: t.tool.guideEyes(String(base.eye_line_from_bottom_percent)),
      removeBgHint: t.tool.removeBgHint,
      modelDefault: t.tool.modelDefault,
      noEditingAtAction: t.warn.noEditingAtAction,
      proceedAnyway: t.warn.proceedAnyway,
      mbUnit: t.unit.mb,
      maxKb: t.tool.maxKb,
      maxKbHint: t.tool.maxKbHint,
      fileLabel: t.spec.file,
      modelsPageLink: t.tool.modelsPageLink,
    }}
  />

  <ul class="trust">
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.free}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-shield" /></svg>{t.trust.inBrowser}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noServer}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noWatermark}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noSignup}</li>
  </ul>
  {/* The objection is not "is it private" but "how would that even work". Answer that. */}
  <p class="trust-why">{t.trust.why}</p>

  <div class="seo" style="margin-top:44px">
    <section>
      <h2>
        <span class="ico"><svg width="22" height="22" aria-hidden="true"><use href="#ic-question" /></svg></span>
        {c.whenToUse}
      </h2>
      <p>{c.whenToUseBody}</p>
      <ul class="related" style="margin-top:12px">
        {CATALOG.slice(0, 6).map((entry) => (
          <li>
            <a href={path(lang, entry.country, entry.doc)}>
              <svg width="24" height="17" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${entry.flag}`} /></svg>
              {t.docTitle[idOf(entry)]}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <p class="disclaimer">{t.seo.disclaimer}</p>
    </section>
  </div>
</Page>
