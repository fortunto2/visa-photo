---
import Home from "../../components/Home.astro";
import { LANGS, DEFAULT_LANG } from "../../data/locales";
import type { ActiveLang } from "../../data/locales";

/**
 * Every locale except the default one, which is served from `/`.
 *
 * Links point at the domain root, not at `/en/`, so that is where the English hub lives: one
 * URL holding the authority instead of passing it along through a redirect. `/en/` still
 * answers — public/_redirects sends it here — because it was published once and someone has
 * it bookmarked.
 */
export function getStaticPaths() {
  return LANGS.filter((lang) => lang !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: ActiveLang };
---

<Home lang={lang} />
