---
import DocPage from "../../../../components/DocPage.astro";
import { CATALOG, type CatalogEntry } from "../../../../data/catalog";
import { LANGS, type ActiveLang } from "../../../../data/locales";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    CATALOG.map((entry) => ({
      params: { lang, country: entry.country, doc: entry.doc },
      props: { entry },
    })),
  );
}

const { lang } = Astro.params as { lang: ActiveLang };
const { entry } = Astro.props as { entry: CatalogEntry };
---

<DocPage lang={lang} entry={entry} mode="check" />
