---
import Page from "../../../layouts/Page.astro";
import { KIND_ICON, sizeLabels, countryGroups, presetOf, dpiOf, type CountryGroup } from "../../../data/catalog";
import { LANGS, dict, type ActiveLang } from "../../../data/locales";
import { absolute, path } from "../../../lib/site";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    countryGroups().map((group) => ({
      params: { lang, country: group.slug },
      props: { group },
    })),
  );
}

const { lang } = Astro.params as { lang: ActiveLang };
const { group } = Astro.props as { group: CountryGroup };

const t = dict(lang);
const countryName = t.country[group.nameKey];
const segments = [group.slug];

const sizes = new Set(
  group.entries.map((e) => {
    const p = presetOf(e);
    return `${p.digital_width}x${p.digital_height}`;
  }),
);
const first = presetOf(group.entries[0]);
const faq = [
  {
    q: t.countryPage.faqDocs(countryName),
    a: t.countryPage.faqDocsA({
      country: countryName,
      list: group.entries.map((e) => t.docShort[e.preset]).join(", "),
    }),
  },
  ...(group.entries.length > 1
    ? [
        {
          q: t.countryPage.faqSame(countryName),
          a:
            sizes.size === 1
              ? t.countryPage.faqSameYes({
                  size: sizeLabels(first, group.entries[0], t.unit).headline,
                })
              : t.countryPage.faqSameNo,
        },
      ]
    : []),
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t.nav.countries, item: absolute(path(lang)) },
      { "@type": "ListItem", position: 2, name: countryName, item: absolute(path(lang, ...segments)) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: t.countryPage.h1(countryName),
    numberOfItems: group.entries.length,
    itemListElement: group.entries.map((entry, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: t.docTitle[entry.preset],
      url: absolute(path(lang, entry.country, entry.doc)),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Page
  lang={lang}
  t={t}
  title={t.countryPage.title(countryName)}
  description={t.countryPage.lead({ country: countryName, n: group.entries.length })}
  segments={segments}
  schema={schema}
>
  <p class="crumb">
    <a href={path(lang)}>{t.nav.countries}</a>
    <span class="doc-pill">
      <svg width="17" height="12" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${group.flag}`} /></svg>
      {countryName}
    </span>
  </p>

  <h1>{t.countryPage.h1(countryName)}</h1>
  <p class="answer">{t.countryPage.lead({ country: countryName, n: group.entries.length })}</p>

  <ul class="hub-grid">
    {group.entries.map((entry) => {
      const p = presetOf(entry);
      const kindIcon = KIND_ICON[entry.kind];
      return (
        <li>
          <a class="hub-card" href={path(lang, entry.country, entry.doc)}>
            <span class="hub-top">
              <svg class="flag" viewBox="0 0 32 22" aria-hidden="true"><use href={`#fl-${entry.flag}`} /></svg>
              <svg class="doc-ico" width="21" height="21" aria-hidden="true"><use href={`#${kindIcon}`} /></svg>
            </span>
            <span class="nm">{t.docShort[entry.preset]}</span>
            <span class="sz">{sizeLabels(p, entry, t.unit).headline}</span>
            <span class="px">{p.digital_width} × {p.digital_height} {t.unit.px}, {dpiOf(p)} dpi</span>
          </a>
        </li>
      );
    })}
  </ul>

  <ul class="trust">
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-shield" /></svg>{t.trust.inBrowser}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noServer}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noWatermark}</li>
    <li><svg width="17" height="17" aria-hidden="true"><use href="#ic-check" /></svg>{t.trust.noSignup}</li>
  </ul>

  <div class="seo" style="margin-top:44px">
    <section>
      <h2>
        <span class="ico"><svg width="22" height="22" aria-hidden="true"><use href="#ic-question" /></svg></span>
        {t.seo.faq}
      </h2>
      {faq.map((item) => (
        <div class="faq-item">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </section>

    <section>
      <h2>
        <span class="ico"><svg width="22" height="22" aria-hidden="true"><use href="#ic-shield" /></svg></span>
        {t.seo.sources}
      </h2>
      <ul>
        {group.entries.map((entry) => (
          <li>
            {t.docTitle[entry.preset]}:{" "}
            <a href={entry.source.url} rel="nofollow noopener">{entry.source.label}</a>
          </li>
        ))}
      </ul>
      <p class="disclaimer" style="margin-top:14px">{t.seo.disclaimer}</p>
    </section>
  </div>
</Page>
