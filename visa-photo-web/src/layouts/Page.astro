---
import "../styles/site.css";
import Sprite from "../components/Sprite.astro";
import Consent from "../components/Consent.astro";
import { toolsFor } from "../data/tools";
import { guideLangs } from "../data/guideText";
import { SITE, absolute, alternates, path } from "../lib/site";
import { LANG_LABEL, LANG_TAG, dirOf } from "../data/i18n";
import type { Dict } from "../data/i18n";
import { LANGS, type ActiveLang, dict, hasSection } from "../data/locales";

interface Props {
  lang: ActiveLang;
  t: Dict;
  title: string;
  description: string;
  /** URL segments after the locale, used to build canonical and hreflang */
  segments?: string[];
  /** extra JSON-LD blocks, already shaped */
  schema?: unknown[];
}

const { lang, t, title, description, segments = [], schema = [] } = Astro.props;

const canonical = absolute(path(lang, ...segments));
/** Only where an article actually exists; the labels are translated everywhere, the prose is not. */
const hasGuides = (l: typeof lang) => guideLangs().includes(l);
const dir = dirOf(lang);

const graph = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.origin,
    inLanguage: LANG_TAG[lang],
  },
  ...schema,
];
---

<!doctype html>
<html lang={LANG_TAG[lang]} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Declared rather than left to the /favicon.ico convention, so the vector one wins where
        it can and the tab stays sharp on a high-density screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icon-512.png" />

    {alternates(segments).map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={absolute("/og.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="text/plain" href={absolute("/llms.txt")} title="llms.txt" />
    <link rel="alternate" type="application/json" href={absolute("/specs.json")} title="All specifications" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {/* Consent Mode v2 defaults, before the container. Everything measurable starts denied;
        Consent.astro flips analytics_storage once the visitor answers. Advertising storage is
        denied here and never granted — nothing on this site sells anything. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
        functionality_storage: "granted",
        security_storage: "granted",
        wait_for_update: 500,
      });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${SITE.gtm}');`} />

    <!-- Queue stub: the tool can fire an event before the deferred script has loaded. -->
    <script is:inline>
      window.sda = window.sda || function () { (window.sda.q = window.sda.q || []).push(arguments); };
    </script>
    <script is:inline defer src={SITE.analytics.src} data-source={SITE.analytics.source}></script>
  </head>

  <body>
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <Sprite />

    <header class="wrap">
      <nav class="site-nav">
        <a class="brand" href={path(lang)}>
          <span class="mark"><svg width="20" height="20" aria-hidden="true"><use href="#ic-visa" /></svg></span>
          <span class="wordmark">
            <span class="wm-name">{SITE.brand.head}<em>{SITE.brand.tail}</em></span>
            <small>{SITE.tagline}</small>
          </span>
        </a>
        <span class="nav-links">
          <a href={path(lang)}>{t.nav.countries}</a>
          <a href={`${path(lang)}#tools`}>{t.nav.tools}</a>
          {hasGuides(lang) && <a href={path(lang, "guides")}>{t.guides.h1}</a>}
        </span>
        {/* A disclosure rather than a row: nine languages do not fit a header, and this needs
            no JavaScript and stays keyboard-reachable. The links are still real links, so a
            crawler that ignores the summary still follows them. */}
        <details class="lang">
          <summary>
            <svg width="16" height="16" aria-hidden="true"><use href="#ic-globe" /></svg>
            {LANG_LABEL[lang]}
          </summary>
          <ul>
            {LANGS.filter((other) => other !== lang).map((other) => (
              <li>
                <a href={path(other, ...segments)} hreflang={LANG_TAG[other]} lang={LANG_TAG[other]}>
                  {LANG_LABEL[other]}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>

    <main class="wrap">
      {/* Every page, not only the root: most DV lottery visitors arrive from Egypt and Saudi
          Arabia straight onto /en/ pages, and the Arabic copy existed with no way to find it. */}
      <div class="lang-offer" hidden data-lang-offer data-lang={lang}>
        {LANGS.filter((other) => other !== lang).map((other) => (
          <a class="lang-offer-link" hidden data-offer={other} href={path(other, ...segments)}
            hreflang={LANG_TAG[other]} lang={LANG_TAG[other]} dir={dirOf(other)}
            data-sda-event="lang_offer_clicked" data-sda-placement={`${lang}>${other}`}>
            {dict(other).readHere} {dirOf(other) === "rtl" ? "←" : "→"}
          </a>
        ))}
        <button type="button" class="lang-offer-close" data-offer-close aria-label="Dismiss">×</button>
      </div>
      <slot />
    </main>

    <footer class="wrap">
      <div class="site-foot">
        <p class="foot-note">{t.seo.disclaimerShort}</p>
        <nav class="foot-links">
          {/* Every tool, from one list, so this and the hub cannot drift apart. The any-size
              page had been orphaned since it was built — in the sitemap, linked from nothing. */}
          {toolsFor(lang, t).map((tool) => <a href={tool.href}>{tool.name}</a>)}
          {hasSection(lang, "skills") && <a href={path(lang, "skills")}>{t.agent.openSkills}</a>}
          {hasSection(lang, "privacy") && <a href={path(lang, "privacy")}>{t.privacyPage!.h1}</a>}
          <a href={SITE.repo} rel="noopener">Source code</a>
          <a href="/llms.txt">llms.txt</a>
          <a href="/specs.json">specs.json</a>
        </nav>
      </div>
    </footer>

    <Consent t={t} privacyHref={hasSection(lang, "privacy") ? path(lang, "privacy") : undefined} />
    <script is:inline define:vars={{ langs: LANGS as string[] }}>
      (function () {
        const KEY = "visayes:lang-offer-dismissed";
        const bar = document.querySelector("[data-lang-offer]");
        let dismissed = false;
        try { dismissed = !!localStorage.getItem(KEY); } catch {}
        if (!bar || dismissed) return;

        const wanted = (navigator.languages || [navigator.language || ""])
          .map((tag) => tag.split("-")[0])
          .find((tag) => langs.includes(tag));
        if (!wanted || wanted === bar.dataset.lang) return;

        const link = bar.querySelector(`[data-offer="${wanted}"]`);
        if (!link) return;
        link.hidden = false;
        bar.hidden = false;
        bar.querySelector("[data-offer-close]")?.addEventListener("click", () => {
          try { localStorage.setItem(KEY, "1"); } catch {}
          bar.hidden = true;
        });
      })();
    </script>
  </body>
</html>
